<rml>
<head>
	<title>Shrine HUD</title>
	<link type="text/rcss" href="shrine_hud.rcss"/>
	<script language="lua">
		local lanternsHit = 0
		local score = 0
		local total = 5

		function updateLanterns(count)
			lanternsHit = count
			local left = total - lanternsHit
			if left < 0 then left = 0 end
			local element = document:GetElementById("lanterns")
			if element then
				element.inner_rml = "Lanterns: " .. tostring(left) .. " left"
			end
		end

		function updateScore(newScore)
			score = newScore
			local element = document:GetElementById("score")
			if element then
				element.inner_rml = "Score: " .. tostring(score)
			end
		end

		function onLoad(event)
			if event and event.current_element then
				document = event.current_element.owner_document
			end

			subscribe("TargetsHitUpdated", function(count)
				updateLanterns(count)
			end)

			subscribe("ScoreChanged", function(newScore)
				updateScore(newScore)
			end)

			subscribe("GameReset", function()
				updateLanterns(0)
				updateScore(0)
				local winScreen = document:GetElementById("win-message")
				if winScreen then
					winScreen.class_name = ""
				end
			end)

			subscribe("AllTargetsDestroyed", function()
				local winScreen = document:GetElementById("win-message")
				if winScreen then
					winScreen.class_name = "show"
				end
			end)
		end
	</script>
</head>
<body onload="onLoad(event)">
	<div id="hud">
		<p id="title">THE SHRINE</p>
		<p id="lanterns">Lanterns: 5 left</p>
		<p id="score">Score: 0</p>
		<p id="instructions">E throw   climb the walls   R reset</p>
	</div>
	<div id="win-message">SHRINE AWAKENED</div>
</body>
</rml>
